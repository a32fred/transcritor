{
  "model": "large-v3",
  "device": "cpu",
  "compute_type": "int8",
  "cpu_threads": 0,
  "beam_size": 5,
  "language": "pt",
  "task": "transcribe",
  "initial_prompt": "Transcrição em português do Brasil com pontuação completa: vírgulas, pontos finais, interrogações, exclamações e travessões. Nomes próprios e siglas são escritos corretamente e em maiúsculas.",
  "vad": true,
  "vad_threshold": 0.5,
  "vad_min_silence_ms": 500,
  "condition_on_previous_text": true,
  "hallucination_silence_threshold": 2.0,
  "word_timestamps": false,
  "formats": ["txt", "srt", "vtt", "json", "md"],
  "txt_paragraph_gap": 1.6,
  "txt_max_chars_per_line": 0,
  "txt_timestamps": false,
  "watch_interval": 5.0,
  "watch_settle_seconds": 3.0,
  "watch_workers": 1,
  "watch_delete_source": false,
  "watch_include_video": true,
  "web_host": "127.0.0.1",
  "web_port": 8765
}
